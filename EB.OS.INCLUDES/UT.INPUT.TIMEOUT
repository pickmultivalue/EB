    IF 1 THEN
        IF FG_MONITOR.SECS THEN
            IN CHR.NBR FOR FG_MONITOR.SECS ELSE
                CHR.NBR=-1
                FG_TIMEOUT=1
                FG_TIMEDOUT=1
            END
        END ELSE
            IN CHR.NBR
        END 
        IF CHR.NBR GT 0 THEN CHR = CHAR(CHR.NBR)
    END ELSE
        CALL JBASECommandNext(Code,FG_TYPEAHEAD.BUF,FG_TIMEOUT)
        CALL EB_CONVCODE(Code, FG_TYPEAHEAD.BUF, FG_ACT.CODE)
        IF NOT(FG_ACT.CODE) THEN
            CHR=FG_TYPEAHEAD.BUF 'R#1'
            CHR.NBR=SEQ(CHR)
        END ELSE CHR='';CHR.NBR=0
    END
