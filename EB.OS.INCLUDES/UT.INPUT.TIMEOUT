    IF 1 THEN
        data_stack = @DATA
        IF LEN(data_stack) THEN
            CHR = data_stack[1,1]
            CHR.NBR = SEQ(CHR)
            FG_TYPEAHEAD.BUFF = data_stack[2,LEN(data_stack)]
        END ELSE
            IF FG_MONITOR.SECS THEN
                IN CHR.NBR FOR FG_MONITOR.SECS ELSE
                    CHR.NBR=-1
                    FG_TIMEOUT=1
                    FG_TIMEDOUT=1
                END
            END ELSE
                IN CHR.NBR
            END
        END
        IF CHR.NBR GT 0 THEN CHR = CHAR(CHR.NBR)
    END ELSE
        CALL JBASECommandNext(Code,FG_TYPEAHEAD.BUFF,FG_TIMEOUT)
        CALL EB_CONVCODE(Code, FG_TYPEAHEAD.BUFF, FG_ACT.CODE)
        IF NOT(FG_ACT.CODE) THEN
            CHR=FG_TYPEAHEAD.BUFF 'R#1'
            CHR.NBR=SEQ(CHR)
        END ELSE CHR=''; CHR.NBR=0
    END
